<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <title><%= content_for(:title) || "Shortstop - URL Shortener" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Shortstop - A simple URL shortener service">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Bootstrap and Chart.js are vendored, not loaded from a CDN, so the
        Content-Security-Policy can stay strict and nothing third-party can
        change under us. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "bootstrap.bundle.min", "data-turbo-track": "reload", defer: true %>
    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main">Skip to main content</a>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark" aria-label="Main">
      <div class="container">
        <a class="navbar-brand" href="<%= root_path %>">
          <strong>Shortstop</strong>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav"
                aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="<%= root_path %>">Home</a>
            </li>
            <% if user_signed_in? %>
              <li class="nav-item">
                <a class="nav-link" href="<%= user_dashboard_path %>">Dashboard</a>
              </li>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button"
                   id="accountMenu" data-bs-toggle="dropdown"
                   aria-expanded="false">
                  <%= current_user.name.presence || current_user.email %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
                  <li><a class="dropdown-item" href="<%= edit_user_registration_path %>">Edit Profile</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%# button_to emits a real form, so signing out works even if JavaScript fails to load %>
                    <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "dropdown-item" %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <a class="nav-link" href="<%= new_user_session_path %>">Sign In</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="<%= new_user_registration_path %>">Sign Up</a>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main id="main" class="flex-grow-1">
      <div class="container mt-3">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="status">
            <%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
          </div>
        <% end %>

        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
          </div>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <footer class="mt-5 py-3 bg-dark text-white text-center">
      <div class="container">
        <p class="mb-0">&copy; <%= Date.current.year %> Shortstop | A simple URL shortening service</p>
      </div>
    </footer>
  </body>
</html>
