<% content_for :title, "Shorten a URL - Shortstop" %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h1 class="h3 mb-0">Shortstop URL Shortener</h1>
        </div>

        <div class="card-body">
          <p class="lead mb-4">Enter a long URL to make it short and easy to share!</p>

          <%= form_with(model: @url, class: "url-form") do |form| %>
            <% if @url.errors.any? %>
              <div class="alert alert-danger" role="alert">
                <h2 class="h6"><%= pluralize(@url.errors.count, "error") %> prevented this URL from being shortened:</h2>
                <ul class="mb-0">
                  <% @url.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :original_url, "URL to shorten", class: "form-label" %>
              <div class="input-group">
                <%= form.url_field :original_url, class: "form-control form-control-lg", placeholder: "https://example.com/very/long/url/to/shorten", required: true, pattern: "https?://.+" %>
                <%= form.submit "Shorten URL", class: "btn btn-primary btn-lg" %>
              </div>
              <div class="form-text">Enter a valid URL including https:// or http://</div>
            </div>
          <% end %>

          <% unless user_signed_in? %>
            <div class="alert alert-info mt-4">
              <p class="mb-2"><strong>Shortening works without an account.</strong> Sign in to keep your links together in a dashboard and see their statistics from any device.</p>
              <div class="mt-3">
                <%= link_to "Sign In", new_user_session_path, class: "btn btn-primary btn-sm me-2" %>
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-primary btn-sm" %>
              </div>
              <%= render "shared/google_sign_in_button" %>
            </div>
          <% end %>

          <% if @recent_urls.present? %>
            <div class="mt-5">
              <h2 class="h4 border-bottom pb-2">
                <%= user_signed_in? ? "Your recent URLs" : "Shortened in this session" %>
              </h2>
              <div class="list-group mt-3">
                <% @recent_urls.each do |url| %>
                  <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                      <h3 class="h6 mb-1 text-truncate" style="max-width: 70%;">
                        <a href="<%= url.original_url %>" target="_blank" rel="noopener noreferrer">
                          <%= url.original_url %>
                        </a>
                        <%= link_to "Stats", stats_url_path(url.shortened_path), class: "ms-2 badge bg-secondary text-white text-decoration-none" %>
                      </h3>
                      <small class="text-muted"><%= time_ago_in_words(url.created_at) %> ago</small>
                    </div>
                    <p class="mb-1">
                      <span class="badge bg-info text-dark me-2"><%= pluralize(url.visits_count, "visit") %></span>
                      <small>
                        <%= link_to full_short_url(url.shortened_path), short_path(url.shortened_path), class: "text-decoration-none" %>
                      </small>
                    </p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="card-footer bg-light">
          <p class="mb-0 text-center text-muted small">
            Powered by <strong>Shortstop</strong> | Made with Ruby on Rails <%= Rails.version %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
