<% content_for :title, "Your short link - Shortstop" %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-success text-white">
          <h1 class="h3 mb-0">URL Successfully Shortened!</h1>
        </div>

        <div class="card-body">
          <div class="mb-4">
            <h2 class="h5">Original URL:</h2>
            <p class="text-truncate border p-2 rounded bg-light"><%= @url.original_url %></p>
          </div>

          <div class="mb-4">
            <h2 class="h5">Shortened URL:</h2>
            <div class="input-group" data-controller="clipboard">
              <label class="visually-hidden" for="shortened-url">Shortened URL</label>
              <input type="text" id="shortened-url" class="form-control"
                     data-clipboard-target="source"
                     value="<%= full_short_url(@url.shortened_path) %>" readonly>
              <button class="btn btn-outline-primary" type="button"
                      data-clipboard-target="button"
                      data-action="clipboard#copy">Copy</button>
            </div>

            <!-- QR Code for the shortened URL, generated locally -->
            <div class="mt-3 text-center">
              <p><strong>QR Code:</strong></p>
              <%= qr_code_svg(full_short_url(@url.shortened_path)) %>
            </div>
          </div>

          <div class="d-flex justify-content-between mt-4">
            <div>
              <p class="text-muted mb-0">
                <small>Created: <%= @url.created_at.strftime("%B %d, %Y") %></small>
              </p>
              <p class="text-muted">
                <small><%= pluralize(@url.visits_count, "visit") %></small>
              </p>
            </div>
            <div>
              <%= link_to "View Statistics", stats_url_path(@url.shortened_path), class: "btn btn-info me-2" %>
              <%= link_to "Shorten Another URL", root_path, class: "btn btn-primary" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
