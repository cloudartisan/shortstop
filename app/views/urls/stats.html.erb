<% content_for :title, "Statistics - Shortstop" %>
<% content_for :head do %>
  <%# Pinned and integrity-checked. This used to load an unversioned "latest". %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"
          integrity="sha384-b0GXujLkk9eYYSmcSfoyZbfyElGAQnDyY0skCHSG6w3JgTMFnz11ggrTAr7seu9f"
          crossorigin="anonymous" defer></script>
<% end %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h1 class="h3 mb-0">URL Statistics</h1>
          <%= link_to "Back to URL", url_path(@url.shortened_path), class: "btn btn-light btn-sm" %>
        </div>

        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-6">
              <h2 class="h5">Original URL:</h2>
              <p class="text-truncate border p-2 rounded bg-light">
                <a href="<%= @url.original_url %>" target="_blank" rel="noopener noreferrer"><%= @url.original_url %></a>
              </p>
            </div>
            <div class="col-md-6">
              <h2 class="h5">Shortened URL:</h2>
              <div class="input-group" data-controller="clipboard">
                <label class="visually-hidden" for="shortened-url">Shortened URL</label>
                <input type="text" id="shortened-url" class="form-control" readonly
                       data-clipboard-target="source"
                       value="<%= full_short_url(@url.shortened_path) %>">
                <button class="btn btn-outline-primary" type="button"
                        data-clipboard-target="button"
                        data-action="clipboard#copy">Copy</button>
              </div>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col-md-4">
              <div class="card border-info">
                <div class="card-body text-center">
                  <h3 class="h6 card-subtitle mb-2 text-muted">Total Visits</h3>
                  <p class="display-6 mb-0"><%= format_number(@total_visits) %></p>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border-success">
                <div class="card-body text-center">
                  <h3 class="h6 card-subtitle mb-2 text-muted">Created</h3>
                  <p class="h5 mb-1"><%= @url.created_at.strftime("%b %d, %Y") %></p>
                  <p class="small text-muted mb-0"><%= time_ago_in_words(@url.created_at) %> ago</p>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border-warning">
                <div class="card-body text-center">
                  <h3 class="h6 card-subtitle mb-2 text-muted">Last Visit</h3>
                  <% if @last_visit_at %>
                    <p class="h5 mb-1"><%= @last_visit_at.strftime("%b %d, %Y") %></p>
                    <p class="small text-muted mb-0"><%= time_ago_in_words(@last_visit_at) %> ago</p>
                  <% else %>
                    <p class="h5 mb-0">No visits yet</p>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Visits chart -->
          <div class="row mb-4">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h2 class="h5 card-title mb-0">Visits Over Time</h2>
                </div>
                <div class="card-body" style="height: 250px;">
                  <% if @total_visits.positive? %>
                    <canvas id="visitsChart" style="width: 100%; height: 100%;"
                            data-controller="visits-chart"
                            data-visits-chart-labels-value="<%= @chart_labels.to_json %>"
                            data-visits-chart-data-value="<%= @chart_data.to_json %>"
                            role="img"
                            aria-label="Daily visits over the last 30 days, totalling <%= @total_visits %> visits"></canvas>
                  <% else %>
                    <div class="alert alert-info" role="status">
                      No visit data available yet. Check back after your link has been used.
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Browser and referrer stats -->
          <div class="row">
            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-header">
                  <h2 class="h5 card-title mb-0">Browsers</h2>
                </div>
                <div class="card-body">
                  <%= render "urls/breakdown", rows: @browsers, label: "Browser", empty: "No browser data available yet." %>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card h-100">
                <div class="card-header">
                  <h2 class="h5 card-title mb-0">Top Referrers</h2>
                </div>
                <div class="card-body">
                  <%= render "urls/breakdown", rows: @referrers, label: "Source", empty: "No referrer data available yet." %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card-footer bg-light">
          <div class="d-flex justify-content-between">
            <%= link_to "Create New URL", root_path, class: "btn btn-outline-secondary" %>
            <%= link_to "View URL Details", url_path(@url.shortened_path), class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
