<%# Shared shell for every Devise page, so they match the rest of the app
    instead of dropping the user onto browser-default form controls. %>
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h1 class="h3 mb-0"><%= title %></h1>
        </div>
        <div class="card-body">
          <%= yield %>
        </div>
      </div>
    </div>
  </div>
</div>
