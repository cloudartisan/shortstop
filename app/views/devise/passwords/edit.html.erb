<% content_for :title, "Change your password - Shortstop" %>
<%= render layout: "devise/shared/auth_card", locals: { title: "Change your password" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="mb-3">
      <%= f.label :password, "New password", class: "form-label" %>
      <%= f.password_field :password, class: "form-control", autofocus: true, autocomplete: "new-password",
            "aria-describedby": "password-help" %>
      <% if @minimum_password_length %>
        <div id="password-help" class="form-text"><%= @minimum_password_length %> characters minimum.</div>
      <% end %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
    </div>

    <%= f.submit "Change my password", class: "btn btn-primary w-100" %>
  <% end %>

  <div class="mt-3">
    <%= render "devise/shared/links" %>
  </div>
<% end %>
