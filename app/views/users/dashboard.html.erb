<% content_for :title, "Dashboard - Shortstop" %>
<div class="container mt-4">
  <h1 class="mb-4">My Dashboard</h1>

  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header">
          <h2 class="h4 mb-0">My Account</h2>
        </div>
        <div class="card-body">
          <p><strong>Name:</strong> <%= current_user.name %></p>
          <p><strong>Email:</strong> <%= current_user.email %></p>
          <p class="mb-0">
            <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-primary" %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col">
      <div class="card">
        <div class="card-header">
          <h2 class="h4 mb-0">My Shortened URLs</h2>
        </div>
        <div class="card-body">
          <% if @urls.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th scope="col">Original URL</th>
                    <th scope="col">Shortened URL</th>
                    <th scope="col">Visits</th>
                    <th scope="col">Created</th>
                    <th scope="col">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @urls.each do |url| %>
                    <tr>
                      <td class="text-truncate" style="max-width: 300px;">
                        <%= link_to url.original_url, url.original_url, target: "_blank", rel: "noopener noreferrer", title: url.original_url %>
                      </td>
                      <td>
                        <%= link_to full_short_url(url.shortened_path), short_path(url.shortened_path), target: "_blank", rel: "noopener noreferrer" %>
                      </td>
                      <td><%= format_number(url.visits_count) %></td>
                      <td><%= time_ago_in_words(url.created_at) %> ago</td>
                      <td>
                        <%= link_to "Stats", stats_url_path(url.shortened_path), class: "btn btn-sm btn-info" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p>You haven't created any shortened URLs yet.</p>
            <p class="mb-0"><%= link_to "Create your first shortened URL", root_path, class: "btn btn-primary" %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
